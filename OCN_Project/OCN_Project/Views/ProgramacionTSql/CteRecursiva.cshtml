@model OCN_Project.Models.DemoResultado?
@{
    ViewData["Title"] = "CTE recursiva";
}

<h1>CTE recursiva: jerarquía de problemáticas</h1>
<p class="text-muted">
    Demostración en vivo de una expresión de tabla común (CTE) recursiva sobre <code>ocn.problematica</code>:
    el ancla toma las problemáticas raíz (<code>idproblematicapadre IS NULL</code>) y el miembro recursivo agrega las
    hijas nivel por nivel, acumulando la ruta tipo breadcrumb. Esta consulta es de solo lectura y se ejecuta al cargar
    la página (no requiere botón).
</p>

<partial name="_DemoResultado" model="Model" />

@if (Model is { Exito: true })
{
    <details class="mt-3">
        <summary>Ver el SQL de la CTE recursiva</summary>
        <pre><code>WITH jerarquia AS (
    SELECT p.idproblematica, p.idproblematicapadre, p.nombre, 0 AS nivel,
           CAST(p.nombre AS nvarchar(4000)) AS ruta
    FROM ocn.problematica p
    WHERE p.idproblematicapadre IS NULL
    UNION ALL
    SELECT h.idproblematica, h.idproblematicapadre, h.nombre, j.nivel + 1,
           CAST(j.ruta + ' > ' + h.nombre AS nvarchar(4000))
    FROM ocn.problematica h
    INNER JOIN jerarquia j ON h.idproblematicapadre = j.idproblematica
)
SELECT idproblematica, idproblematicapadre, nombre, nivel, ruta
FROM jerarquia
ORDER BY ruta
OPTION (MAXRECURSION 100);</code></pre>
    </details>
}
