@model OCN_Project.Models.Entities.CategoriaProblematica

@{
    ViewData["Title"] = "Nueva categoría";
}

<h1>Nueva categoría de problemática</h1>
<h4>CategoriaProblematica</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="p. ej. Educación, Salud mental" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="Activo" class="form-check-input" checked />
                <label asp-for="Activo" class="form-check-label"></label>
            </div>
            <div class="mb-3">
                <input type="submit" value="Crear" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
