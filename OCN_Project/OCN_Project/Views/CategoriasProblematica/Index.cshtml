@model IEnumerable<OCN_Project.Models.Entities.CategoriaProblematica>

@{
    ViewData["Title"] = "Categorías de problemática";
}

<h1>Categorías de problemática</h1>
<p class="text-muted">Catálogo simple para agrupar problemáticas.</p>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva categoría</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Activo)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Nombre</td>
            <td>@(item.Activo ? "Sí" : "No")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdCategoria" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Details" asp-route-id="@item.IdCategoria" class="btn btn-sm btn-info">Detalles</a>
                <a asp-action="Delete" asp-route-id="@item.IdCategoria" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
