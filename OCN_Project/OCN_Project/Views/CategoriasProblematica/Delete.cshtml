@model OCN_Project.Models.Entities.CategoriaProblematica

@{
    ViewData["Title"] = "Eliminar categoría";
}

<h1>Eliminar categoría</h1>
<h3>¿Seguro que deseas eliminar esta categoría?</h3>
@if (ViewBag.PuedeEliminar == false)
{
    <div class="alert alert-warning">
        <strong>No se puede eliminar esta categoría.</strong>
        Tiene problemáticas registradas con esta categoría.
        Elimine o reasigne esas problemáticas antes de volver a intentarlo.
    </div>
}
<div>
    <h4>CategoriaProblematica</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Activo)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Activo)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdCategoria" />
        <input type="submit" value="Eliminar" class="btn btn-danger" disabled="@(ViewBag.PuedeEliminar == false)" />
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </form>
</div>
