@model OCN_Project.Models.CasoComparacionResultado?
@{
    ViewData["Title"] = "Optimización — Caso 2";
}

<h1>Caso 2 — Intervenciones en proceso (índice filtrado)</h1>
<p class="text-muted">Tratamiento simple: consulta ANTES → índice filtrado → consulta DESPUÉS → limpieza.</p>

<div class="card mb-3">
    <div class="card-header">Sobre los índices filtrados y el requisito 3</div>
    <div class="card-body">
        <p>
            El índice es <strong>filtrado</strong> (<code>WHERE estado in ('Planeada', 'EnProceso')</code>): solo
            contiene las filas vivas del flujo de trabajo, por lo que es más pequeño, mantiene estadísticas más
            representativas de ese subconjunto y puede dar mejor plan para consultas que coinciden con su filtro.
            La consulta consulta las intervenciones con esos estados registradas en enero de 2025
            (<code>fecharegistro >= '20250101' and fecharegistro < '20250201'</code>).
        </p>
        <div class="alert alert-warning mb-0">
            <strong>Requisito 3 de la tarea — ojo:</strong> puede perfectamente pasar que el optimizador
            <em>no</em> use el índice filtrado en el plan DESPUÉS (tabla chica, selectividad distinta a la estimada,
            estadísticas recién creadas, etc.). La página lo detecta automáticamente y lo marca como
            <strong>evidencia de aprendizaje, no como fracaso</strong>: el veredicto aparece tras ejecutar la
            comparación. Nota: si no hay intervenciones de enero de 2025, la consulta devuelve 0 filas pero el
            plan y las estadísticas se capturan igual.
        </div>
        <pre class="border bg-light p-2 small mt-3 mb-0">create nonclustered index idx_intervencion_estado_fecharegistro_planeada_en_proceso
on ocn.intervencion (fecharegistro)
include (idtipointervencion, idobservacionproblematica, idrecurso, fechacompletado, estado)
where estado in ('Planeada', 'EnProceso')</pre>
    </div>
</div>

<form asp-action="EjecutarCaso2" method="post" class="mb-4">
    <button type="submit" class="btn btn-primary">Ejecutar comparación antes/después</button>
</form>

@if (Model != null)
{
    <hr />

    @if (Model.Error != null)
    {
        <div class="alert alert-danger">
            <strong>Error durante la corrida:</strong> @Model.Error — la limpieza se ejecutó igualmente (revisa los pasos).
        </div>
    }

    @if (Model.Exito)
    {
        @if (Model.IndiceUsadoEnDespues)
        {
            <div class="alert alert-success">
                <strong>El optimizador SÍ usó el índice filtrado:</strong> el plan DESPUÉS contiene un
                Index Seek/Index Scan sobre <code>@Model.NombreIndice</code>.
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <strong>El optimizador NO usó el índice filtrado.</strong> @Model.NotaAprendizaje
            </div>
        }
    }

    @if (Model.Antes != null)
    {
        <partial name="_SeccionResultado" model="Model.Antes" />
    }
    @if (Model.Despues != null)
    {
        <partial name="_SeccionResultado" model="Model.Despues" />
    }

    <div class="card mb-3">
        <div class="card-header">Pasos ejecutados</div>
        <div class="card-body py-2">
            <ul class="list-group list-group-flush">
                @foreach (var paso in Model.Pasos)
                {
                    <li class="list-group-item @(paso.StartsWith("ERROR", StringComparison.Ordinal) ? "list-group-item-danger" : "")">@paso</li>
                }
            </ul>
        </div>
    </div>
}
