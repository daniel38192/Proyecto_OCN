@using System.Globalization
@model OCN_Project.Models.ResultadoEjecucion
@* Sección compartida de una corrida (ANTES o DESPUÉS): datos, STATISTICS IO/TIME, plan real y descarga .sqlplan. *@
@{
    var plan = Model.Plan;
}
<div class="card mb-3 border-secondary">
    <div class="card-header bg-light">
        <strong>@Model.Titulo</strong>
        <span class="text-muted">— duración medida por la app: @Model.DuracionMs ms</span>
    </div>
    <div class="card-body">

        <h6 class="mt-1">Resultados de la consulta</h6>
        <partial name="_TablaDatos" model="Model.TablaDatos" />

        <div class="row mt-3">
            <div class="col-lg-6">
                <h6>STATISTICS IO</h6>
                @if (Model.MensajesIo.Count == 0)
                {
                    <p class="text-muted small">(no se capturaron mensajes de IO)</p>
                }
                else
                {
                    <pre class="border bg-light p-2 small mb-0">@string.Join("\n", Model.MensajesIo)</pre>
                    <p class="text-muted small mb-0 mt-1">Total de lecturas lógicas: <strong>@Model.TotalLecturasLogicas</strong></p>
                }
            </div>
            <div class="col-lg-6">
                <h6>STATISTICS TIME</h6>
                @if (Model.MensajesTiempo.Count == 0)
                {
                    <p class="text-muted small">(no se capturaron mensajes de tiempo)</p>
                }
                else
                {
                    <pre class="border bg-light p-2 small mb-0">@string.Join("\n", Model.MensajesTiempo)</pre>
                }
                @if (Model.MensajesOtros.Count > 0)
                {
                    <details class="mt-2">
                        <summary class="text-muted small">Otros mensajes capturados</summary>
                        <pre class="border bg-light p-2 small mb-0">@string.Join("\n", Model.MensajesOtros)</pre>
                    </details>
                }
            </div>
        </div>

        <h6 class="mt-3">Plan de ejecución real</h6>
        @if (plan == null)
        {
            <div class="alert alert-warning py-2 mb-2">
                No se capturó (o no se pudo interpretar) el plan XML de esta corrida; el resto de la evidencia sigue disponible.
            </div>
        }
        else
        {
            <ul class="mb-2">
                <li>Costo estimado del statement: <strong>@plan.CostoEstimado.ToString("0.0000", CultureInfo.InvariantCulture)</strong></li>
                <li>Filas estimadas: <strong>@plan.FilasEstimadas.ToString("0.######", CultureInfo.InvariantCulture)</strong></li>
                <li>Nivel de optimización: <strong>@plan.NivelOptimizacion</strong></li>
                <li>Grado de paralelismo: <strong>@plan.GradoParalelismo</strong></li>
            </ul>

            @if (plan.Advertencias.Count > 0)
            {
                <div class="alert alert-warning py-2">
                    <strong>Advertencias del plan:</strong>
                    <ul class="mb-0">
                        @foreach (var advertencia in plan.Advertencias)
                        {
                            <li>@advertencia</li>
                        }
                    </ul>
                </div>
            }

            <div class="table-responsive mb-2">
                <table class="table table-striped table-hover table-sm">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Operador físico</th>
                            <th>Operador lógico</th>
                            <th>Objeto</th>
                            <th>Costo subárbol</th>
                            <th>Filas estimadas</th>
                            <th>Filas reales</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var numero = 0;
                        }
                        @foreach (var operador in plan.Operadores)
                        {
                            numero++;
                            <tr>
                                <td>@numero</td>
                                <td><strong>@operador.OperadorFisico</strong></td>
                                <td>@operador.OperadorLogico</td>
                                <td>@operador.Objeto</td>
                                <td>@operador.CostoSubarbol.ToString("0.0000", CultureInfo.InvariantCulture)</td>
                                <td>@operador.FilasEstimadas.ToString("0.######", CultureInfo.InvariantCulture)</td>
                                <td>@(operador.FilasRealesDisponibles ? operador.FilasReales.ToString("0.######", CultureInfo.InvariantCulture) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <details class="mb-2">
                <summary>Ver plan XML completo</summary>
                <pre class="border bg-light p-2 small" style="max-height: 400px; overflow: auto;">@Model.PlanXml</pre>
            </details>

            <a asp-action="DescargarPlan" asp-route-id="@Model.IdPlanCache" target="_blank" class="btn btn-sm btn-outline-secondary">
                Descargar plan (.sqlplan) para abrir en SSMS
            </a>
        }
    </div>
</div>
