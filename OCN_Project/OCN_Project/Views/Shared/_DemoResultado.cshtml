@model OCN_Project.Models.DemoResultado?
@* Vista parcial compartida: pinta el resultado de una demostración T-SQL
   (error, pasos ejecutados, secciones de evidencia y justificación de diseño). *@
@if (Model != null)
{
    @if (!Model.Exito)
    {
        <div class="alert alert-danger" role="alert">
            <strong>No se pudo completar la demostración.</strong> @Model.Error
        </div>
    }

    @if (Model.Pasos.Count > 0)
    {
        <h2 class="mt-4">Pasos ejecutados</h2>
        <ol>
            @foreach (var paso in Model.Pasos)
            {
                <li>@paso</li>
            }
        </ol>
    }

    @foreach (var seccion in Model.Secciones)
    {
        <div class="card mb-3">
            <div class="card-header fw-bold">@seccion.Titulo</div>
            <div class="card-body">
                @if (seccion.Tabla is not null)
                {
                    @if (seccion.Tabla.Filas.Count == 0)
                    {
                        <p class="text-muted mb-0">(sin filas)</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead>
                                    <tr>
                                        @foreach (var columna in seccion.Tabla.Columnas)
                                        {
                                            <th>@columna</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fila in seccion.Tabla.Filas)
                                    {
                                        <tr>
                                            @foreach (var celda in fila)
                                            {
                                                <td>@celda</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                @if (seccion.Notas.Count > 0)
                {
                    <ul class="mb-0 @(seccion.Tabla is not null ? "mt-2" : "")">
                        @foreach (var nota in seccion.Notas)
                        {
                            <li>@nota</li>
                        }
                    </ul>
                }
            </div>
        </div>
    }

    <div class="alert alert-secondary" role="alert">
        <h2 class="h5 alert-heading">Justificación de diseño</h2>
        <p class="mb-0" style="white-space: pre-line">@Model.Justificacion</p>
    </div>
}
