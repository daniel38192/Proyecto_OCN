@model OCN_Project.Models.Entities.Periodo

@{
    ViewData["Title"] = "Eliminar periodo";
}

<h1>Eliminar periodo</h1>
<h3>¿Seguro que deseas eliminar este periodo?</h3>
<div>
    <h4>Periodo</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CodigoPeriodo)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.CodigoPeriodo)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FechaInicio)</dt>
        <dd class="col-sm-9">@Model.FechaInicio.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FechaFin)</dt>
        <dd class="col-sm-9">@(Model.FechaFin?.ToString("dd/MM/yyyy") ?? "En curso")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Activo)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Activo)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdPeriodo" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </form>
</div>
