@model OCN_Project.Models.Entities.Problematica

@{
    ViewData["Title"] = "Detalle de problemática";
}

<h1>Detalle de problemática</h1>

<div>
    <h4>Problematica</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>

        <dt class="col-sm-3">Categoría</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Categoria.Nombre)</dd>

        <dt class="col-sm-3">Problemática padre</dt>
        <dd class="col-sm-9">@(Model.ProblematicaPadre?.Nombre ?? "")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Descripcion)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Descripcion)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Activo)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Activo)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.IdProblematica" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
