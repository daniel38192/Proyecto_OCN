@model OCN_Project.Models.Entities.Problematica

@{
    ViewData["Title"] = "Editar problemática";
}

<h1>Editar problemática</h1>
<h4>Problematica</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdProblematica" />
            <div class="mb-3">
                <label class="form-label">Categoría</label>
                <select asp-for="IdCategoria" class="form-select" asp-items="ViewBag.IdCategoria">
                    <option value="">-- Selecciona una categoría --</option>
                </select>
                <span asp-validation-for="IdCategoria" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Problemática padre (opcional, para subproblemáticas)</label>
                <select asp-for="IdProblematicaPadre" class="form-select" asp-items="ViewBag.IdProblematicaPadre">
                    <option value="">-- Sin problemática padre --</option>
                </select>
                <span asp-validation-for="IdProblematicaPadre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label"></label>
            </div>
            <div class="mb-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
