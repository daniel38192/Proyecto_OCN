@model IEnumerable<OCN_Project.Models.Entities.Zona>

@{
    ViewData["Title"] = "Zonas";
}

<h1>Zonas</h1>
<p class="text-muted">Catálogo de zonas de estudio del proyecto OCN.</p>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva zona</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.CodigoZona)</th>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>División</th>
            <th>Tipo de zona</th>
            <th>@Html.DisplayNameFor(model => model.Activo)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.CodigoZona</td>
            <td>@item.Nombre</td>
            <td>@item.Division?.Nombre</td>
            <td>@item.TipoZona?.Nombre</td>
            <td>@(item.Activo ? "Sí" : "No")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdZona" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Details" asp-route-id="@item.IdZona" class="btn btn-sm btn-info">Detalles</a>
                <a asp-action="Delete" asp-route-id="@item.IdZona" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
